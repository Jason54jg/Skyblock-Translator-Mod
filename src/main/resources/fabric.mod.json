{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "Client-side chat, NPC dialogue, scoreboard, and item tooltip translator for Hypixel SkyBlock.",
	"authors": [
		"fridorin"
	],
	"contact": {
		"homepage": "https://github.com/fridorin/Skyblock-Translator-Mod",
		"sources": "https://github.com/fridorin/Skyblock-Translator-Mod",
		"issues": "https://github.com/fridorin/Skyblock-Translator-Mod/issues"
	},
	"license": "MIT",
	"icon": "assets/skyblock_translator/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"ru.fridorin.translator.TranslatorModClient"
		],
		"modmenu": [
			"ru.fridorin.translator.ModMenuIntegration"
		]
	},
	"mixins": [
		"skyblock_translator.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=3.8.1"
